  <!-- Copies the built DLL into the game's plugins folder. Skipped in CI or if the game is missing.
       ContinueOnError so a locked DLL (game running) warns instead of failing the build. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CI)' != 'TRUE' And Exists('$(PluginsPath)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsPath)" ContinueOnError="true" />
  </Target>
</Project>
